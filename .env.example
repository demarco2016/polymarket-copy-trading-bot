# === WALLET TARGETS ===
# Comma-separated list of wallet addresses to mirror
TARGET_WALLETS=0x...,0x...,0x...

# === POLYMARKET API ===
PRIVATE_KEY=0x...
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
FUNDER_ADDRESS=
SIGNATURE_TYPE=0
BUILDER_CODE=

# === POSITION SIZING ===
# % of bankroll per copied trade (start at 1-2%)
POSITION_SIZE_PCT=2.0
MAX_POSITION_SIZE_USD=500

# === RISK CONTROLS ===
# Max drawdown % from peak (auto-kill at this level)
MAX_DRAWDOWN_PCT=10.0
# Max open positions at once
MAX_OPEN_POSITIONS=10
# Comma-separated market slugs to skip (degen blacklist)
BLACKLIST_MARKETS=

# === POLLING ===
# Seconds between wallet checks (recommend: 30-60)
POLL_INTERVAL=60
